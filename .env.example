# Copy this to ".env" and fill in when you go to production.

# --- Proxies (turn on when you buy residential proxies) ---
# SeleniumBase format — NO http:// prefix:
#   USER:PASS@gate.smartproxy.com:7000   (authenticated)
#   IP:PORT                               (open)
#   socks5://USER:PASS@IP:PORT            (socks)
# Leave USE_PROXIES=false unless PROXY_URL is a plan you actually own: a proxy
# that refuses to tunnel means Chrome never reaches the carrier at all, and
# every row of a bulk run fails (the error says so — see PageLoadFailed).
USE_PROXIES=false
PROXY_URL=USER:PASS@gate.smartproxy.com:7000

# --- Bulk runs: how many browsers at once ---
# Each worker drives its own Chrome (~0.5-1 GB with a carrier page open), so
# this trades RAM for wall clock. The work planner splits the biggest carrier
# group across the spare workers, so 4 genuinely quarters a UPS-heavy file
# instead of leaving three workers idle behind one long queue. Use 1 on a small
# VM, and drop back if a carrier starts rate-limiting the IP.
BATCH_CONCURRENCY=4

# --- Rate limiting (seconds between requests; higher = safer) ---
MIN_DELAY=5
MAX_DELAY=20
MAX_RETRIES=3

# --- UC Mode tuning ---
RECONNECT_TIME=4      # seconds chromedriver stays detached to slip past bot-check
HEADLESS=false        # UC Mode works BEST headed; only set true if you must
SOLVE_CAPTCHA=true    # auto-click Cloudflare/reCAPTCHA if a challenge appears

# --- Storage ---
DB_PATH=tracking.db
