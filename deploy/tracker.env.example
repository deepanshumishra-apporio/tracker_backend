# systemd EnvironmentFile for the tracker backend.
# Copy to deploy/tracker.env and fill in the real values, then:
#     sudo cp deploy/tracker.env /etc/tracker.env
#
# IMPORTANT — systemd env-file format, NOT shell:
#   * KEY=value only, one per line.
#   * NO trailing "# comments" on a value line (systemd keeps them as text).
#   * NO quotes needed; NO `export`.

# --- Server bind (Nginx/Caddy can reverse-proxy in front of this) ---
HOST=0.0.0.0
PORT=8000

# --- Browser display ---
# On a headless Linux VM, run Chrome HEADED inside a virtual display: UC Mode is
# far harder for anti-bot to detect this way. USE_XVFB=true makes SeleniumBase
# start/stop Xvfb itself, so no separate Xvfb process or entrypoint is needed
# (the `xvfb` package installed by setup.sh must be present).
HEADLESS=false
USE_XVFB=true

# GUI CAPTCHA clicking needs a real display + pyautogui; leave off on a server.
# UC Mode's reconnect handles most Cloudflare challenges on its own.
SOLVE_CAPTCHA=false

# --- Anti-ban: RESIDENTIAL proxies (REQUIRED in production) ---
# An Azure VM IP is a DATACENTER IP and gets blocked by the carriers' anti-bot
# just like any cloud host. A residential/mobile proxy is what actually gets you
# through. SeleniumBase format, NO http:// prefix:
#   USER:PASS@gate.smartproxy.com:7000     (authenticated / rotating gateway)
#   socks5://USER:PASS@IP:PORT             (socks)
USE_PROXIES=true
PROXY_URL=USER:PASS@gate.smartproxy.com:7000

# --- FedEx via Scrape.do (residential proxy + JS render API; beats Akamai) ---
# FedEx blocks datacenter IPs, so it uses Scrape.do instead of the browser.
# Get the token from your Scrape.do dashboard. Other carriers still use PROXY_URL.
SCRAPEDO_TOKEN=your-scrapedo-token-here
SCRAPEDO_GEO=us

# --- Rate limiting (seconds between requests; higher = safer) ---
MIN_DELAY=5
MAX_DELAY=20
MAX_RETRIES=2
RECONNECT_TIME=4

# --- CORS: deployed frontend origin(s), comma-separated, no trailing slash ---
CORS_ORIGINS=https://tracker-frontend-tawny.vercel.app
